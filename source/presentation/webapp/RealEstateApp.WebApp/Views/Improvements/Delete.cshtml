@model RealEstateApp.Core.Application.ViewModels.Catalog.ImprovementViewModel
@{
    ViewData["Title"] = "Delete Improvement";
}

<h2 class="section-title text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete Improvement</h2>

<div class="card-real">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    @if (Model.PropertiesCount > 0)
    {
        <div class="alert alert-info">
            This improvement is used in @Model.PropertiesCount propert@(Model.PropertiesCount == 1 ? "y" : "ies"). It will be removed from those properties, but the properties themselves will not be deleted.
        </div>
    }
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-real">Cancel</a>
    </form>
</div>