@model RealEstateApp.Core.Application.ViewModels.Property.PropertyDetailsViewModel

@{
    ViewData["Title"] = $"Property {Model.Code}";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-md-7">
        <div id="propertyCarousel" class="carousel slide mb-3" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.ImagePaths.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Model.ImagePaths[i]" class="d-block w-100" alt="Property image" style="max-height:400px;object-fit:cover;">
                    </div>
                }
            </div>
            @if (Model.ImagePaths.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            }
        </div>

        <h3>@Model.Code — @Model.PropertyTypeName</h3>
        <p><strong>Sale type:</strong> @Model.SaleTypeName | <strong>Status:</strong> @Model.Status</p>
        <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
        <p><strong>Size:</strong> @Model.Size m² | <strong>Bedrooms:</strong> @Model.Bedrooms | <strong>Bathrooms:</strong> @Model.Bathrooms</p>
        <p>@Model.Description</p>

        @if (Model.Improvements.Any())
        {
            <p><strong>Improvements:</strong> @string.Join(", ", Model.Improvements)</p>
        }

        <form asp-action="ToggleFavorite" method="post" class="d-inline">
            <input type="hidden" name="propertyId" value="@Model.Id" />
            <input type="hidden" name="returnAction" value="Details" />
            <button type="submit" class="btn @(Model.IsFavorite ? "btn-danger" : "btn-outline-danger")">
                @(Model.IsFavorite ? "♥ Remove from favorites" : "♡ Add to favorites")
            </button>
        </form>

        <div class="card mt-4">
            <div class="card-header">Agent</div>
            <div class="card-body">
                <p class="mb-1"><strong>@Model.AgentFullName</strong></p>
                <p class="mb-1">@Model.AgentPhone</p>
                <p class="mb-0">@Model.AgentEmail</p>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header">Chat with the agent</div>
            <div class="card-body" style="max-height:300px;overflow-y:auto;">
                @if (!Model.Messages.Any())
                {
                    <p class="text-muted">No messages yet. Start the conversation.</p>
                }
                else
                {
                    foreach (var msg in Model.Messages)
                    {
                        <div class="mb-2 @(msg.SenderRole == "Client" ? "text-end" : "text-start")">
                            <span class="badge @(msg.SenderRole == "Client" ? "bg-primary" : "bg-secondary")">
                                @msg.SenderRole
                            </span>
                            <div>@msg.Content</div>
                            <small class="text-muted">@msg.CreatedAt.ToString("g")</small>
                        </div>
                    }
                }
            </div>
            <div class="card-footer">
                <form asp-action="SendMessage" method="post">
                    <input type="hidden" name="PropertyId" value="@Model.Id" />
                    <div class="input-group">
                        <input type="text" name="Content" class="form-control" placeholder="Write a message..." />
                        <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">My offers</div>
            <div class="card-body">
                @if (!Model.Offers.Any())
                {
                    <p class="text-muted">You haven't made any offers for this property.</p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var offer in Model.Offers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @offer.Amount.ToString("C")
                                <span class="badge @(offer.Status == "Accepted" ? "bg-success" : offer.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                    @offer.Status
                                </span>
                            </li>
                        }
                    </ul>
                }

                @if (Model.CanCreateOffer)
                {
                    <form asp-action="SendOffer" method="post">
                        <input type="hidden" name="PropertyId" value="@Model.Id" />
                        <div class="input-group">
                            <input type="number" step="0.01" name="Amount" class="form-control" placeholder="Offer amount" />
                            <button type="submit" class="btn btn-success">Make offer</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-0">@Model.OfferBlockedReason</div>
                }
            </div>
        </div>
    </div>
</div>