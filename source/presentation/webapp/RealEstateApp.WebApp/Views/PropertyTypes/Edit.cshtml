@model RealEstateApp.Core.Application.ViewModels.Catalog.PropertyTypeViewModel
@{
    ViewData["Title"] = "Edit Property Type";
}

<h2 class="section-title"><i class="fa-solid fa-house-chimney me-2"></i>Edit Property Type</h2>

<div class="card-real">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-real">Save</button>
        <a asp-action="Index" class="btn btn-outline-real">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}