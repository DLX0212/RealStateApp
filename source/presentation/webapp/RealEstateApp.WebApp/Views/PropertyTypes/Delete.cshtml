@model RealEstateApp.Core.Application.ViewModels.Catalog.PropertyTypeViewModel
@{
    ViewData["Title"] = "Delete Property Type";
}

<h2 class="section-title text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete Property Type</h2>

<div class="card-real">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    @if (Model.PropertiesCount > 0)
    {
        <div class="alert alert-warning">
            This property type has @Model.PropertiesCount associated propert@(Model.PropertiesCount == 1 ? "y" : "ies") and cannot be deleted.
        </div>
    }
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" @(Model.PropertiesCount > 0 ? "disabled" : "")>Delete</button>
        <a asp-action="Index" class="btn btn-outline-real">Cancel</a>
    </form>
</div>