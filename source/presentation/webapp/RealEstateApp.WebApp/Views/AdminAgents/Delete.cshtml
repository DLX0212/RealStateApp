@model RealEstateApp.Core.Application.ViewModels.Agent.AgentAdminViewModel
@{
    ViewData["Title"] = "Delete Agent";
}

<h2 class="section-title"><i class="fa-solid fa-triangle-exclamation me-2 text-danger"></i>Delete Agent</h2>

<div class="card-real p-4">
    <p>Are you sure you want to delete this agent?</p>
    <ul>
        <li><strong>Name:</strong> @Model.FirstName @Model.LastName</li>
        <li><strong>Email:</strong> @Model.Email</li>
        <li><strong>Properties:</strong> @Model.PropertiesCount</li>
    </ul>

    @if (Model.PropertiesCount > 0)
    {
        <div class="alert alert-warning">
            This agent has @Model.PropertiesCount propert(y/ies) registered. Deleting this agent will permanently delete all of their properties as well.
        </div>
    }

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash me-1"></i>Confirm Delete
        </button>
        <a asp-action="Index" class="btn btn-outline-real" style="border-color: var(--color-border); color: var(--color-text-muted);">
            Cancel
        </a>
    </form>
</div>