@model List<RealEstateApp.Core.Application.ViewModels.Account.DeveloperUserViewModel>
@{
    ViewData["Title"] = "Manage Developers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="section-title mb-0"><i class="fa-solid fa-code me-2"></i>Manage Developers</h2>
    <a asp-action="Create" class="btn btn-real"><i class="fa-solid fa-plus me-1"></i>New Developer</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="fa-solid fa-user-slash"></i>
        <p>@ViewBag.NoResultsMessage</p>
    </div>
}
else
{
    <div class="card-real p-0">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var developer in Model)
                {
                    <tr>
                        <td>@developer.UserName</td>
                        <td>@developer.FirstName</td>
                        <td>@developer.LastName</td>
                        <td>@developer.Email</td>
                        <td>
                            <span class="badge @(developer.IsActive ? "bg-success" : "bg-secondary")">
                                @(developer.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@developer.Id" class="btn btn-sm btn-outline-real">Edit</a>
                            <form asp-action="ChangeStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@developer.Id" />
                                <input type="hidden" name="isActive" value="@(!developer.IsActive)" />
                                <button type="submit" class="btn btn-sm @(developer.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                    @(developer.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}